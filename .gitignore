# BEGIN swamp managed section - DO NOT EDIT

# Runtime data (not needed in version control)
.swamp/

# Local extension sources (developer-specific, not shared)
.swamp-sources.yaml

# Claude Code configuration (managed by swamp)
.claude/worktrees/
.claude/settings.local.json
.claude/scheduled_tasks.lock
.claude/scheduled_tasks.json
# END swamp managed section

# fka workspaces. review.yaml is the reviewed artifact and is worth
# committing; everything else is regenerated and carries absolute paths from
# the machine that generated it.
.fka/*/bin/
.fka/*/surface.json
.fka/*/settings.snippet.json
.fka/*/SKILL.snippet.md
